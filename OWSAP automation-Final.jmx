        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Unique data and dynamic ID" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename" /><stringProp name="parameters" /><stringProp name="script">// Make mutable create/update payload names unique per run and reuse IDs created in this run.
def runId = vars.get('__run_id')
if (!runId) { runId = System.currentTimeMillis().toString(); vars.put('__run_id', runId) }
def method = sampler.getMethod()
def path = sampler.getPath()
// Replace old UUIDs in CRUD URLs with the latest ID captured for the resource family.
def families = [
  'master-configurations':'master_config_id', 'devices':'device_id', 'tags':'tag_id',
  'onboarding/nodes':'node_id', 'onboarding/sites':'site_id', 'onboarding/users':'user_id',
  'roles':'role_id', 'groups':'group_id', 'views':'view_id', 'sequences':'sequence_id',
  'custom-maps':'map_id', 'quality-check/sections':'qc_section_id', 'quality-check/questions':'qc_question_id',
  'bookmarks':'bookmark_id', 'export':'export_id'
]
for (entry in families) {
  def marker = entry.key
  def variable = entry.value
  def id = vars.get(variable)
  if (id &amp;&amp; path.contains(marker) &amp;&amp; (method in ['GET','PUT','PATCH','DELETE'])) {
    path = path.replaceAll('/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?=/|$)', '/'+id)
    sampler.setPath(path)
    break
  }
}
// Unique common name fields in request bodies.
try {
  def args=sampler.getArguments()
  if(args &amp;&amp; args.size()&gt;0) {
    def a=args.getArgument(0); def body=a.getValue()
    if(body) {
      body=body.replaceAll(/(?i)("(?:name|deviceName|device_name|tagName|siteName|projectName|roleName|groupName|title|sequenceName|viewName|mapName)"\s*:\s*")([^"]+)(")/) { m,p,v,q -&gt; p+v+'_JMX_'+runId+q }
      a.setValue(body)
    }
  }
} catch(Exception ignored) {}
</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree /><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture created resource ID" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename" /><stringProp name="parameters" /><stringProp name="script">// Capture the first UUID-like id from successful JSON responses.
def text=prev.getResponseDataAsString()
def m=(text =~ /"(?:id|uuid|deviceId|siteId|nodeId|tagId|roleId|groupId|viewId|sequenceId|mapId)"\s*:\s*"([0-9a-fA-F-]{36})"/)
if(m.find()) {
  def id=m.group(1)
  def path=sampler.getPath()
  if(path.contains('/master-configurations')) vars.put('master_config_id',id)
  else if(path.contains('/devices')) vars.put('device_id',id)
  else if(path.contains('/tags')) vars.put('tag_id',id)
  else if(path.contains('/onboarding/nodes')) vars.put('node_id',id)
  else if(path.contains('/onboarding/sites')) vars.put('site_id',id)
  else if(path.contains('/onboarding/users')) vars.put('user_id',id)
  else if(path.contains('/roles')) vars.put('role_id',id)
  else if(path.contains('/groups')) vars.put('group_id',id)
  else if(path.contains('/views')) vars.put('view_id',id)
  else if(path.contains('/sequences')) vars.put('sequence_id',id)
  else if(path.contains('/custom-maps')) vars.put('map_id',id)
  else if(path.contains('/quality-check/sections')) vars.put('qc_section_id',id)
  else if(path.contains('/quality-check/questions')) vars.put('qc_question_id',id)
  else if(path.contains('/bookmarks')) vars.put('bookmark_id',id)
  else if(path.contains('/export')) vars.put('export_id',id)
}
