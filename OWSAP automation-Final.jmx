</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree /><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Capture created resource ID" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename" /><stringProp name="parameters" /><stringProp name="script">// Capture the first UUID-like id from successful JSON responses.
def text=prev.getResponseDataAsString()
def m=(text =~ /"(?:id|uuid|deviceId|siteId|nodeId|tagId|roleId|groupId|viewId|sequenceId|mapId)"\s*:\s*"([0-9a-fA-F-]{36})"/)
if(m.find()) {
  def id=m.group(1)
  def path=sampler.getPath()
  if(path.contains('/master-configurations')) vars.put('master_config_id',id)
  else if(path.contains('/devices')) vars.put('device_id',id)
  else if(path.contains('/tags')) vars.put('tag_id',id)
  else if(path.contains('/onboarding/nodes')) vars.put('node_id',id)
  else if(path.contains('/onboarding/sites')) vars.put('site_id',id)
  else if(path.contains('/onboarding/users')) vars.put('user_id',id)
  else if(path.contains('/roles')) vars.put('role_id',id)
  else if(path.contains('/groups')) vars.put('group_id',id)
  else if(path.contains('/views')) vars.put('view_id',id)
  else if(path.contains('/sequences')) vars.put('sequence_id',id)
  else if(path.contains('/custom-maps')) vars.put('map_id',id)
  else if(path.contains('/quality-check/sections')) vars.put('qc_section_id',id)
  else if(path.contains('/quality-check/questions')) vars.put('qc_question_id',id)
  else if(path.contains('/bookmarks')) vars.put('bookmark_id',id)
  else if(path.contains('/export')) vars.put('export_id',id)
}
